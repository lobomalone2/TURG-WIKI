---
/**
 * Header.astro
 * Cabeçalho customizado para Ludi de Nanã com busca em destaque,
 * suporte visual em vermelho e preto e logo sempre visível.
 */
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
---

<div class="ludi-header">
  <div class="ludi-header__title">
    <SiteTitle {...Astro.props} />
  </div>

  <div class="ludi-header__search">
    <Search {...Astro.props} />
  </div>

  <div class="ludi-header__actions">
    <LanguageSelect {...Astro.props} />
  </div>
</div>

<style>
  .ludi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .ludi-header__title {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ludi-header__search {
    flex: 1;
    max-width: 40rem;
    margin-inline: 1rem;
  }

  .ludi-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  @media (max-width: 50rem) {
    .ludi-header__title :global(span) {
      display: none;
    }
    .ludi-header__search {
      margin-inline: 0.25rem;
    }
  }
</style>

<script>
  function setupSearchTriggers() {
    const searchLinks = document.querySelectorAll('a[href="#buscar"], a[href="#search"]');
    searchLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const searchBtn = document.querySelector('button[data-open-modal]') as HTMLButtonElement | null;
        if (searchBtn) {
          searchBtn.click();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchTriggers);
  } else {
    setupSearchTriggers();
  }
  document.addEventListener('astro:page-load', setupSearchTriggers);
</script>
